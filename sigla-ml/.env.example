# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Supabase Storage Buckets
SUPABASE_BUCKET_GESTURES=gesture-samples
SUPABASE_BUCKET_MODELS=model-files

# Node.js backend URL (used to fetch samples and update model records)
BACKEND_URL=http://localhost:8080/api

# Shared API key — must match ML_API_KEY in the backend .env
ML_API_KEY=your_ml_api_key_here

# Model config
# 2 hands x 21 landmarks x (x,y,z) = 126, plus 7 pose keypoints x (x,y,z) = 21.
# MUST match FEATURE_SIZE in sigla-mobile PredictionService.kt / HandLandmarkHelper.kt.
# This shipped as 126 while the code default was 147, so a fresh clone that copied
# this file trained a wrong-shaped model.
FEATURE_SIZE=147
SEQUENCE_LENGTH=30

# Reject clips that would otherwise become mostly repeated padding or omit the
# body trajectory used by the classifier.
MIN_DETECTED_HAND_FRAMES=12
MIN_HAND_COVERAGE=0.35
MIN_POSE_COVERAGE=0.75
MIN_SEQUENCE_MOTION=0.50
# Longest run of consecutive hands-less frames tolerated once signing has started.
# Kept equal to the app's NO_HAND_TIMEOUT: a longer run ends the gesture on-device,
# so a clip containing one is not something the phone could ever classify.
# Longest hand dropout tolerated, in SECONDS (extraction subsamples, so a frame
# count would mean a different duration on every clip length). Equals the app's
# NO_HAND_TIMEOUT / MIN_ACCEPTABLE_FPS = 6/24.
MAX_MISSING_HAND_SECONDS=0.25
DEFAULT_SOURCE_FPS=30
# Pose coverage of the FINAL stored 30-frame window, in the same terms the phone
# uses (PredictionService.MIN_POSE_FRAMES / SEQUENCE_LENGTH = 24/30).
MIN_POSE_WINDOW_COVERAGE=0.8

# Mirror augmentation MUST stay paired with the app's camera scope — see
# tests/test_mobile_parity_flags.py, which asserts exactly this pairing.
#
# OFF because MainActivity pins FORCE_BACK_CAMERA_ONLY = true: the greetings clips
# were all recorded on the BACK camera in one orientation, so mirroring teaches an
# orientation no user can now produce and spends half the augmentation budget on it.
#
# Turning this on while the app is pinned to one lens is safe but wasteful. Turning
# it OFF while the app can still select the FRONT camera is the dangerous direction:
# the front lens delivers a horizontally flipped image, measured at 96.1% -> 24.8%
# accuracy without mirrored training data. Re-enable together with the camera toggle.
MIRROR_AUGMENTATION_ENABLED=false
MIRROR_AUGMENTATION_RATIO=1.0

# Simulate brief live MediaPipe losses (bounded below the app's pose-coverage gate).
LANDMARK_DROPOUT_ENABLED=true
LANDMARK_DROPOUT_MAX_FRAMES=4

# Weight-only float16 quantization of the shipped .tflite (~half the size).
# OFF: currently a no-op for the LSTM. Its verification step needs the Python
# tf.lite.Interpreter, which cannot load Select-TF (Flex) ops, so the check always
# fails and float32 ships anyway. See the note in app/services/train.py before
# enabling — the verification has to be reworked first.
TFLITE_FLOAT16=false
TFLITE_FLOAT16_MAX_DRIFT=0.02

# Match the mobile pipeline, which computes pose every second frame and reuses the
# newest completed result (normally one frame stale) between updates.
POSE_CADENCE_AUGMENTATION_ENABLED=true
POSE_CADENCE_INTERVAL=2
POSE_CADENCE_LAG=1
# Share of augmented samples that get the phone's stale-pose cadence applied.
# Applied as a composable POST-STEP (it used to be one of ~6 mutually-exclusive
# augmentation types, so only ~17% of samples ever got it while the phone
# produces this pairing on every single frame).
POSE_CADENCE_APPLY_RATIO=0.60

# Cover signer-speed and effective phone-FPS variation.
TEMPORAL_STRETCH_MIN=0.80
TEMPORAL_STRETCH_MAX=1.20

# Keep disabled for precision: partial openings can be shared by several words.
PREFIX_AUGMENTATION_ENABLED=false

# Choose the stopping epoch using a signer that is completely absent from the
# selection model's training set. The final deployment fit still uses all signers.
GROUP_MODEL_SELECTION=true
MODEL_SELECTION_SIGNER_FOLD=0

# Accuracy-first training gate. Re-uploading one person's clips cannot satisfy it.
MIN_REAL_SAMPLES_PER_CLASS=20
MIN_SIGNERS_PER_CLASS=4
MIN_SAMPLES_PER_SIGNER=4

# PostgreSQL / Supabase connection string
PG_URI=postgresql://user:password@host:port/database

# Server
PORT=8080

# JWT signing secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Gmail SMTP credentials for OTP emails
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=SIGLA your_email@gmail.com

# Internal ML service URL and shared API key
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_ml_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_MODELS=model-files
SUPABASE_BUCKET_GESTURES=gesture-samples
SUPABASE_BUCKET_VIDEOS=gesture-videos

# Comma-separated list of allowed CORS origins (admin frontend URL)
ALLOWED_ORIGINS=http://localhost:5173

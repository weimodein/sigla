<?xml version="1.0" encoding="utf-8"?>
<!-- "Tonal Ink" dark palette (2026-10-02): light mode inverted. Light mode is a
     white page with navy brand surfaces carrying white text; here the page is deep
     navy and the brand surfaces (Home stats, Settings profile, History summary,
     the translate button, primary buttons, selected chips) turn pale blue carrying
     navy text. sg_on_brand is therefore NAVY in this file, not white, so anything
     that must stay white regardless of theme (text over the camera, on the red
     warning pill, inside the dark video stage) uses sg_on_dark instead.

     Contrast (WCAG): sg_text on sg_bg 16.3:1, sg_text_secondary on sg_bg 8.9:1 and
     on sg_tint 7.4:1, sg_brand_text on sg_bg 11.2:1, sg_on_brand on sg_brand 8.8:1,
     sg_on_brand_secondary on sg_brand 5.4:1. -->
<resources>
    <color name="sg_brand">#C9D8FA</color>
    <color name="sg_brand_text">#B8CCF8</color>
    <color name="sg_bg">#0C1430</color>
    <color name="sg_tint">#172350</color>
    <color name="sg_bar_bg">#111B3E</color>
    <color name="sg_text">#EEF3FC</color>
    <color name="sg_text_secondary">#A9B6D6</color>
    <!-- 8% white, matching light mode's 8% brand divider. -->
    <color name="sg_divider">#14FFFFFF</color>
    <color name="sg_danger">#EF5350</color>
    <color name="sg_success">#4CAF50</color>
    <color name="sg_on_brand">#13306B</color>
    <color name="sg_on_brand_secondary">#CC13306B</color>
    <!-- 12% navy disc on the pale brand surface (light mode: 15% white on navy). -->
    <color name="sg_on_brand_disc">#1F13306B</color>
    <color name="sg_nav_bar">@color/sg_bar_bg</color>
    <!-- Onboarding illustrations (illus_onboard_*): a muted navy and a mid blue that read on the dark page. -->
    <color name="sg_illus_soft">#233A73</color>
    <color name="sg_illus_mid">#6F8FD6</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Revised dark palette (2026-09-28): the original values put sg_bg and sg_tint
     too close in lightness (#0B1530 vs #15244B), so every card, pill and category
     tile blended into the background instead of reading as a distinct surface, and
     sg_text_secondary was dim enough to be hard to read. sg_bg is now a deeper,
     near-black navy so sg_tint (unchanged step size, now off a darker base) reads
     as a clearly lighter surface; sg_bar_bg sits between the two as originally
     intended. sg_brand is unchanged — it was never too bright on its own, it just
     had no contrast partner; with the surfaces around it separated, the three
     brand-filled hero cards (Home stats, Settings profile, History summary) read
     as intentional accents again instead of a wash. sg_text_secondary is brighter
     for legibility. -->
<resources>
    <color name="sg_brand">#2A55B8</color>
    <color name="sg_brand_text">#9DB8F2</color>
    <color name="sg_bg">#070D1F</color>
    <color name="sg_tint">#1B2C57</color>
    <color name="sg_bar_bg">#111C3B</color>
    <color name="sg_text">#F0F3FA</color>
    <color name="sg_text_secondary">#B8C2DB</color>
    <!-- 10% white: divider needs to stay visible against the darker sg_bg. -->
    <color name="sg_divider">#1AFFFFFF</color>
    <color name="sg_danger">#EF5350</color>
    <color name="sg_success">#4CAF50</color>
    <color name="sg_on_brand">#FFFFFF</color>
    <color name="sg_on_brand_secondary">#CCFFFFFF</color>
    <color name="sg_nav_bar">@color/sg_bar_bg</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain-HTTP (cleartext) traffic to the local development backend only.
    Android P+ blocks cleartext by default; the app talks to the backend over
    http:// on the LAN during on-device testing.
    Remove this (and use https://) for a production build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.101</domain>
        <domain includeSubdomains="false">192.168.56.1</domain>
        <domain includeSubdomains="false">192.168.100.6</domain>
        <domain includeSubdomains="false">192.168.100.163</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">172.20.97.78</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">187.127.208.90</domain>
        <domain includeSubdomains="false">2a02:4780:5e:2690</domain>
    </domain-config>
</network-security-config>

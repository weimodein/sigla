<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable single-field edit dialog (Settings' name field; the word-bank
     category dialogs). Restyled to the sg_* design system. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sg_space_20"
    android:paddingEnd="@dimen/sg_space_20"
    android:paddingTop="@dimen/sg_space_8"
    android:paddingBottom="@dimen/sg_space_8">

    <TextView
        android:id="@+id/tvDialogSubtitle"
        style="@style/Sigla.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sg_space_16"
        android:text=""
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDialogField"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusTopStart="@dimen/sg_radius_sm"
        app:boxCornerRadiusTopEnd="@dimen/sg_radius_sm"
        app:boxCornerRadiusBottomStart="@dimen/sg_radius_sm"
        app:boxCornerRadiusBottomEnd="@dimen/sg_radius_sm"
        app:boxStrokeColor="@color/sg_brand"
        app:counterEnabled="true"
        app:counterMaxLength="60"
        app:hintTextColor="@color/sg_brand">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogField"
            style="@style/Sigla.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="@color/sg_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvDialogError"
        style="@style/Sigla.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sg_space_4"
        android:layout_marginTop="@dimen/sg_space_4"
        android:text=""
        android:textColor="@color/sg_danger"
        android:visibility="gone" />

</LinearLayout>

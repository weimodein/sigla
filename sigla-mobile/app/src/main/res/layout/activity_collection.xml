<?xml version="1.0" encoding="utf-8"?>
<!-- activity_collect_gesture.xml
     Scope rules:
       - Static gestures: max 100 samples per user
       - Motion gestures: max 150 samples per user
       - Camera switch button (front/rear)
       - Cancel button (terminates entire collection and discards samples)
       - Two progress bars: current session capture progress + user's total quota used
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview fills screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hand skeleton overlay -->
    <com.example.sigla.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cameraPreview"
        app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
        app:layout_constraintStart_toStartOf="@id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@id/cameraPreview" />
        
    <!-- TOP BAR — matches activity_main.xml style -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topBarCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#E6001E3D"
        app:strokeColor="#334A90E2"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <!-- Cancel button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="Cancel and discard samples"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#14FFFFFF"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- Word label + gesture type -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_label_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    tools:text="HELLO" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_type_placeholder"
                    android:textColor="#80B0D4FF"
                    android:textSize="10sp"
                    android:letterSpacing="0.03"
                    android:fontFamily="sans-serif"
                    tools:text="STATIC · 1 HAND" />

            </LinearLayout>

            <!-- Camera switch button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Flip"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2F80ED"
                app:strokeColor="#4A90E2"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#FFFFFF" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- REC indicator: visible while capturing -->
    <TextView
        android:id="@+id/tvRec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● REC"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarCard"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- "No Hands Detected" overlay message -->
    <TextView
        android:id="@+id/tvNoHandsDetected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✋ No Hands Detected"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#CCD32F2F"
        android:padding="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBarCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        tools:visibility="visible" />

    <!-- Center overlay hint (shown before collection starts) -->
    <TextView
        android:id="@+id/tvOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC0056A4"
        android:padding="16dp"
        android:text="@string/collection_overlay_hint"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Done overlay: shown when collection is complete -->
    <LinearLayout
        android:id="@+id/overlayDone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE0056A4"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/collection_complete"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDoneSampleCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#E9F2FB"
            android:textSize="15sp"
            android:gravity="center"
            tools:text="100 samples collected" />

        <TextView
            android:id="@+id/tvDonePath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#E9F2FB"
            android:textSize="13sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvUploadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Upload progress bar -->
        <ProgressBar
            android:id="@+id/progressUpload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Submit"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#2F80ED"
            app:cornerRadius="14dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />

    </LinearLayout>

    <!-- BOTTOM CONTROLS -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC0056A4"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Session capture progress label row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SESSION PROGRESS"
                android:textColor="#E9F2FB"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvSessionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 100"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="45 / 100" />

        </LinearLayout>

        <!-- Session progress bar -->
        <ProgressBar
            android:id="@+id/progressCapture"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progressTint="#D32F2F"
            android:progressBackgroundTint="#4D0056A4"
            android:layout_marginBottom="12dp" />

        <!-- Total quota label row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR QUOTA FOR THIS WORD"
                android:textColor="#E9F2FB"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvQuotaCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 100 used"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="45 / 100 used" />

        </LinearLayout>

        <!-- Quota progress bar -->
        <ProgressBar
            android:id="@+id/progressTotal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progressTint="#E9F2FB"
            android:progressBackgroundTint="#4D0056A4"
            android:layout_marginBottom="12dp" />

        <!-- Validation hint -->
        <TextView
            android:id="@+id/tvValidationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validating hand landmarks…"
            android:textColor="#E9F2FB"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
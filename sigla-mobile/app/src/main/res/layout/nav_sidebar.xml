<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebarDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:background="#E5F3FE"
    android:elevation="8dp">

    <!-- ── HEADER ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:paddingBottom="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_header_curved_outer" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_header_curved"
                android:paddingTop="12dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginTop="-18dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:foregroundGravity="center">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/sigla"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:contentDescription="SigLa logo" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSidebarUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="SigLa"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSidebarEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SigLa"
                        android:textColor="#B7C2DE"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </RelativeLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- ── NAVIGATION SECTION ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="90dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:rotation="-90"
                android:text="NAVIGATION"
                android:textColor="#8B96B8"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:singleLine="true" />

        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#D8DEEC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <!-- Main Interface -->
            <LinearLayout
                android:id="@+id/navMainInterface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_nav_item_selector"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="#FFFFFF"
                        android:contentDescription="Main interface" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvNavTitleMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main Interface"
                        android:textColor="@color/nav_text_primary_selector"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavSubtitleMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start translating"
                        android:textColor="@color/nav_text_secondary_selector"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Word Bank -->
            <LinearLayout
                android:id="@+id/navWordBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_nav_item_selector"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#FFFFFF"
                        android:contentDescription="Word bank" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvNavTitleWordBank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Word Bank"
                        android:textColor="@color/nav_text_primary_selector"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavSubtitleWordBank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View and customized FSL signs"
                        android:textColor="@color/nav_text_secondary_selector"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Translation History -->
            <LinearLayout
                android:id="@+id/navTranslationHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_nav_item_selector"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#FFFFFF"
                        android:contentDescription="Translation history" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvNavTitleHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translation History"
                        android:textColor="@color/nav_text_primary_selector"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavSubtitleHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign languages used"
                        android:textColor="@color/nav_text_secondary_selector"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_nav_item_selector"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="#FFFFFF"
                        android:contentDescription="Settings" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvNavTitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textColor="@color/nav_text_primary_selector"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavSubtitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App references"
                        android:textColor="@color/nav_text_secondary_selector"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ── SPACER ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── FOOTER ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:alpha="0.35">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#1A2E5A"
                android:contentDescription="SIGLA logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIGLA"
                android:textColor="#1A2E5A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
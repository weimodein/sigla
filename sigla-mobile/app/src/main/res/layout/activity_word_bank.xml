<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_word_bank.xml
    Scope:
      - Category dropdown to filter entries
      - Selecting an entry plays audio + shows demo video
      - Users can create custom categories
      - Retractable sidebar (no back button — sidebar matches activity_main.xml pattern)

    Top bar structure: page background (light blue-gray) → outer halo (topBarOuterWrapper,
    fixed 116dp, elevation 6dp for a soft drop shadow) → inner navy curve (fixed
    104dp) → 48dp white icon box with blue lines + module title (22sp) +
    "Filipino Sign Language Translator" subtitle. Below that, with a clean 20dp gap
    (no overlap), sits filterRow: a light-blue rounded container (bg_filterrow, 18dp
    padding) holding two elevated white cards (10dp corner radius, no border, shadow
    instead) — the search bar (fills remaining space, manual icon+EditText since
    TextInputLayout's startIconTint wasn't rendering) and the category dropdown
    (wrap_content so "All Category" + icon always stay on one line) — 12dp gap
    between them.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sig_page_bg">

        <!-- TOP BAR + SEARCH/CATEGORY ROW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Outer halo: FIXED height, not wrap_content -->
            <FrameLayout
                android:id="@+id/topBarOuterWrapper"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:background="@drawable/bg_topbar_outer"
                android:elevation="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Navy curve: FIXED height, not wrap_content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_topbar_curved"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical">

                    <!-- Sidebar 3-line hamburger button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSidebar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="Open menu"
                        app:icon="@drawable/ic_menu_lines"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/sig_icon_accent"
                        app:backgroundTint="@color/sig_header_button_bg"
                        app:cornerRadius="14dp" />

                    <!-- Screen title + subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvTopBarTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Word Bank"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/tvTopBarSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Filipino Sign Language Translator"
                            android:textColor="#C2CFE3"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- SEARCH + CATEGORY ROW -->
            <!-- Each control has its OWN light-blue elevated card (not one shared
                 card, not zero cards). The search icon sits in the blue padding
                 area, outside the white text pill, per the reference. -->
            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/topBarOuterWrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Search card: light-blue outer card, dark-blue icon sitting in the
                     blue padding, white pill wrapping only the text (no icon inside). -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/sig_accent_pill">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="6dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="@color/sig_icon_accent"
                            android:contentDescription="Search" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/sig_surface_card">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSearch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:inputType="text"
                                android:maxLines="1"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:textSize="13sp"
                                android:textColor="@color/sig_text_primary"
                                android:textColorHint="@color/sig_text_secondary"
                                android:hint="Search words…"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Category card: same light-blue card style as search, icon+text
                     directly on the blue background (no inner white pill). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryPill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="All Category"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/sig_text_primary"
                    android:elevation="2dp"
                    app:icon="@drawable/ic_chevron_down_circle"
                    app:iconTint="@null"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/sig_accent_pill" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CATEGORY GRID (default view) -->
        <LinearLayout
            android:id="@+id/categoryGridContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="178dp">

            <TextView
                android:id="@+id/tvBrowseByCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse by Category"
                android:textColor="@color/sig_text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

        </LinearLayout>

        <!-- ENTRY COUNT LABEL -->
        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showing 24 words"
            android:textColor="@color/sig_text_primary"
            android:textSize="10sp"
            android:gravity="end|center_vertical"
            android:paddingEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"

            android:layout_marginTop="188dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="208dp"
            android:visibility="gone" />

        <!-- WORD LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="208dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:layout_marginTop="208dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/sig_text_secondary"
                android:layout_marginBottom="16dp"
                android:contentDescription="No words" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No words found"
                android:textColor="@color/sig_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try selecting a different category or clearing the search."
                android:textColor="@color/sig_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_word_bank.xml
    Scope:
      - Category dropdown to filter entries
      - Selecting an entry plays audio + shows demo video
      - Users can create custom categories
      - Retractable sidebar (no back button — sidebar matches activity_main.xml pattern)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E3F2FD">

        <!-- TOP BAR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#E6001E3D"
            app:strokeColor="#334A90E2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Sidebar 3-line hamburger button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidebar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Open menu"
                    app:icon="@drawable/ic_menu_lines"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#14FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

                <!-- Screen title + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Word Bank"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Language Interpreter"
                        android:textColor="#80B0D4FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <!-- Create custom category button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateCategory"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Category"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#33FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CATEGORY FILTER + SEARCH ROW -->
        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="80dp"
            android:elevation="2dp">

            <!-- Search bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:boxStrokeColor="#4A90E2"
                app:boxStrokeWidth="1dp"
                app:boxBackgroundColor="#F8F9FF"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="#4A90E2"
                app:hintTextColor="#4A90E2"
                android:hint="Search words…">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:textColor="#111111"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategory"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#4A90E2"
                app:boxStrokeWidth="1dp"
                app:boxBackgroundColor="#F8F9FF"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconTint="#4A90E2"
                app:hintTextColor="#4A90E2"
                android:hint="All Categories">

                <AutoCompleteTextView
                    android:id="@+id/actvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ENTRY COUNT LABEL -->
        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showing 24 words"
            android:textColor="#0D3E6B"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:background="#BBDEFB"
            android:layout_marginTop="212dp" />
        
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="236dp"
            android:visibility="gone" />

        <!-- WORD LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="236dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:layout_marginTop="236dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#B0BEC5"
                android:layout_marginBottom="16dp"
                android:contentDescription="No words" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No words found"
                android:textColor="#78909C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try selecting a different category or clearing the search."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
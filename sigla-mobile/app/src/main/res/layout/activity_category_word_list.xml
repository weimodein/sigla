<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_category_word_list.xml
    Scope:
      - Shows every word belonging to one category as a simple icon+label list
      - Back button (no sidebar) returns to Word Bank
      - Search box filters within this category only (no category dropdown)

    Header structure matches activity_word_bank.xml (same outer halo + navy
    curve drawables/heights) so the two screens read as one continuous flow;
    only the leading control (back arrow instead of hamburger) and the title
    block (category name + word count instead of app name + tagline) differ.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sig_page_bg">

    <!-- TOP BAR + SEARCH ROW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/topBarOuterWrapper"
            android:layout_width="0dp"
            android:layout_height="122dp"
            android:background="@drawable/bg_topbar_outer"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_topbar_curved"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center_vertical">

                <!-- Back button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Back"
                    app:icon="@drawable/ic_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/sig_icon_accent"
                    app:backgroundTint="@color/sig_header_button_bg"
                    app:cornerRadius="14dp" />

                <!-- Category title + word count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tvCategorySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 Words"
                        android:textColor="#C2CFE3"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- SEARCH ROW (full width, no category dropdown) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/sig_accent_pill"
            app:layout_constraintTop_toBottomOf="@id/topBarOuterWrapper"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/sig_icon_accent"
                    android:contentDescription="Search" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sig_surface_card">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCategorySearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:textSize="13sp"
                        android:textColor="@color/sig_text_primary"
                        android:textColorHint="@color/sig_text_secondary"
                        android:hint="Search in category…"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="186dp"
        android:visibility="gone" />

    <!-- WORD LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryWords"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="186dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:layout_marginTop="186dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/sig_text_secondary"
            android:layout_marginBottom="16dp"
            android:contentDescription="No words" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No words found"
            android:textColor="@color/sig_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try a different search term."
            android:textColor="@color/sig_text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

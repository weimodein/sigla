<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_word_bank.xml
    Scope:
      - Category dropdown to filter entries
      - Selecting an entry plays audio + shows demo video
      - Users can create custom categories
      - Retractable sidebar (no back button — sidebar matches activity_main.xml pattern)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E3F2FD">

        <!-- TOP BAR + SEARCH/CATEGORY ROW -->
        <!-- Wrapped in a ConstraintLayout so the search row anchors to the header's
             actual bottom edge (with a negative margin for the overlap seen in the
             reference design) instead of guessing a fixed pixel offset from the
             screen top, which drifts on different devices/font scales. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/topBar"
                layout="@layout/topbar_curved"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- SEARCH + CATEGORY ROW -->
            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_filterrow"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="-18dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="3dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Search bar -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:boxStrokeColor="#CCD6E4"
                    app:boxStrokeWidth="1dp"
                    app:boxBackgroundColor="#F8F9FF"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    app:startIconTint="#4A90E2"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:textColor="#111111"
                        android:hint="Search words…"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category pill -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryPill"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="All Category"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#0D3E6B"
                    app:icon="@drawable/ic_chevron_down_circle"
                    app:iconSize="18dp"
                    app:iconGravity="end"
                    app:strokeColor="#4A90E2"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="#FFFFFF" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CATEGORY GRID (default view) -->
        <LinearLayout
            android:id="@+id/categoryGridContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="128dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="24dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tvBrowseByCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse by Category"
                android:textColor="#0D3E6B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />

        </LinearLayout>

        <!-- ENTRY COUNT LABEL -->
        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showing 24 words"
            android:textColor="#0D3E6B"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:background="#BBDEFB"
            android:layout_marginTop="194dp" />
        
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="218dp"
            android:visibility="gone" />

        <!-- WORD LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="218dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:layout_marginTop="218dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#B0BEC5"
                android:layout_marginBottom="16dp"
                android:contentDescription="No words" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No words found"
                android:textColor="#78909C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try selecting a different category or clearing the search."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
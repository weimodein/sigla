<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_otp_verify.xml
    Used by ProfileActivity → showChangePasswordDialog()
    Six individual digit boxes, resend note, and expiry/attempts label.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A 6-digit verification code has been sent to your registered email. The code expires in 5 minutes."
        android:textColor="#546E7A"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.4"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Six OTP digit boxes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit1"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit2"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit3"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit4"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit5"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otpDigit6"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_otp_box"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Attempts + expiry label -->
    <TextView
        android:id="@+id/tvOtpAttemptsLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5 attempts remaining · Expires in 5:00"
        android:textColor="#4A90E2"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Error -->
    <TextView
        android:id="@+id/tvOtpError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D32F2F"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Resend row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive it? "
            android:textColor="#6C757D"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOtpResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend code"
            android:textColor="#4A90E2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtpResendCooldown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (0:59)"
            android:textColor="#4A90E2"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground">

        <!-- Camera preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hand skeleton overlay -->
        <com.example.sigla.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/cameraPreview"
            app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="@id/cameraPreview"
            app:layout_constraintEnd_toEndOf="@id/cameraPreview" />

        <!-- Hamburger menu (top-left) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenu"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&#x2630;"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="0dp"
            android:background="#66000000"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="12dp" />

        <!-- Result card (overlaid on camera) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:cardBackgroundColor="#CC1A237E"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="@id/cameraPreview"
            app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="32dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <!-- English result -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HELLO"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <!-- Filipino translation (shown/hidden by toggle) -->
                <TextView
                    android:id="@+id/tvFilipinoResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#90CAF9"
                    android:textSize="22sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98% [STATIC]"
                    android:textColor="#7986CB"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <!-- Filipino toggle button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFilipino"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Show Filipino"
                    android:textColor="#90CAF9"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    app:strokeColor="#90CAF9" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Too-many-hands warning -->
        <TextView
            android:id="@+id/tvHandsWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More than 2 hands detected"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#CC000000"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp" />

        <!-- Emergency button (bottom-right corner of camera) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergency"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="SOS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorEmergency"
            app:cornerRadius="36dp"
            app:layout_constraintBottom_toTopOf="@id/bottomPanel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            app:layout_constraintTop_toBottomOf="@id/btnEmergency"
            app:layout_constraintEnd_toEndOf="@id/btnEmergency"
            app:layout_constraintStart_toStartOf="@id/btnEmergency"
            android:layout_marginTop="-4dp" />

        <!-- Bottom panel -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Buffer progress bar -->
            <ProgressBar
                android:id="@+id/progressBuffer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/colorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFrames"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Detecting…"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVelocity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=""
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#FFB74D"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Status + Camera buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/loading_models"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlipCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/flip_camera"
                    android:textSize="12sp"
                    app:backgroundTint="#263238" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Sidebar (drawer) ── -->
    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>

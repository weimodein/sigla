<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sig_page_bg">

        <!-- Camera preview card occupying the main screen area -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cameraCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/sig_surface_card"
            app:strokeColor="@color/sig_border_card"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/topBarCard"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.example.sigla.OverlayView
                    android:id="@+id/overlayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvReadyOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/colorSuccess"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:background="#CC000000"
                    android:padding="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp" />

                <!-- Result card centered over camera preview -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="12dp"
                    app:cardBackgroundColor="#661A2F3F"
                    app:strokeColor="#80FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_gravity="center"
                    android:layout_margin="32dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp">

                        <!-- English result. wrap_content so the box hugs short words
                             tightly; maxWidth caps how wide it can grow before wrapping
                             to a second line. textSize is fixed (not autosize — confirmed
                             via on-device testing to not engage reliably on this device)
                             but chosen small enough that even the longest realistic single
                             word (e.g. "UNDERSTAND") fits within maxWidth on one line, so
                             wrapping only ever happens at word boundaries, never mid-word. -->
                        <TextView
                            android:id="@+id/tvResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:maxWidth="220dp"
                            android:maxLines="2"
                            android:text="HELLO"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false" />

                        <!-- Filipino translation — same hug-to-content treatment; these
                             phrases run longer than the English labels. -->
                        <TextView
                            android:id="@+id/tvFilipinoResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:maxWidth="220dp"
                            android:maxLines="2"
                            android:text=""
                            android:textColor="@color/sig_accent"
                            android:textSize="11sp"
                            android:textStyle="italic"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:fontFamily="@font/poppins_medium" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── TOP BAR (full width, no rounding) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/sig_chrome_navy"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <!-- Sidebar hamburger button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidebar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Open menu"
                    app:icon="@drawable/ic_menu_lines"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/sig_icon_accent"
                    app:backgroundTint="@color/sig_header_button_bg"
                    app:cornerRadius="10dp" />

                <!-- App name + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SigLa"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Language Interpreter"
                        android:textColor="#80B0D4FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.03"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlipCamera"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Flip camera"
                    app:icon="@drawable/ic_camera_flip"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/sig_icon_accent"
                    app:backgroundTint="@color/sig_header_button_bg"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating SOS button above bottom card -->
        <!-- Too-many-hands warning -->
        <TextView
            android:id="@+id/tvHandsWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More than 2 hands detected"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_medium"
            android:background="#CC000000"
            android:padding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp" />

        <!-- No hands detected overlay -->
        <TextView
            android:id="@+id/tvNoHandsDetected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✋ No Hands Detected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:background="#CCD32F2F"
            android:padding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/topBarCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone" />


        <!-- ── BOTTOM PANEL ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomPanelCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/sig_chrome_navy"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/bottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Top status row with ready badge -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:tint="#4CAF50" />

                                <TextView
                                    android:id="@+id/tvStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Detecting…"
                                    android:textColor="#B0D4FF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins_bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:tint="#4CAF50" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hand tracking is active"
                                    android:textColor="#B0D4FF"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/poppins_regular" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCooldownStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_ready_badge"
                            android:padding="8dp"
                            android:text="Ready"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Filipino toggle. Lives here rather than inside cardResult: that card is
                     invisible except for ~2s after each recognition, which made the toggle
                     unreachable most of the time. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFilipino"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="start"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Show Filipino"
                    android:textColor="@color/sig_accent"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium"
                    app:strokeColor="@color/sig_accent"
                    app:cornerRadius="16dp" />

                <!-- Words / letters vocabulary switch.
                     Starts GONE and is only shown when an alphabet model is
                     actually loaded, so a build or a backend without one looks
                     exactly as it did before. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleVocabulary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="start"
                    android:layout_marginBottom="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Spell letters"
                    android:textColor="@color/sig_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins_medium"
                    app:strokeColor="@color/sig_accent"
                    app:cornerRadius="16dp" />

                <!-- Green detection loader -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Detection loading"
                    android:textColor="#B0D4FF"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular" />

                <ProgressBar
                    android:id="@+id/progressBuffer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginBottom="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#334CAF50"
                    android:progressTint="#4CAF50" />

                <!-- Bottom stats row: FPS, loading percent, motion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFrames"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FPS: 0"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvBufferPercent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="0%"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvVelocity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="motion"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text=""
                        android:textColor="#FFB74D"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Camera button removed per request; bottom card minimized to content -->

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating SOS container above bottom card -->
        <FrameLayout
            android:id="@+id/floatingEmergencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="18dp"
            android:translationZ="16dp"
            android:elevation="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clipToPadding="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmergency"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="SOS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="32dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="2dp"
                    app:iconGravity="textStart"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvEmergencyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="120dp"
                    android:maxLines="2"
                    android:lines="2"
                    android:breakStrategy="balanced"
                    android:text="Hold 2 seconds\nfor emergency"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:background="#66000000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Sidebar ── -->
    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
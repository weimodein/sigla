<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Camera preview — fills between top bar and bottom panel -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/topBarCard"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hand skeleton overlay -->
        <com.example.sigla.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/cameraPreview"
            app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="@id/cameraPreview"
            app:layout_constraintEnd_toEndOf="@id/cameraPreview" />

        <!-- ── TOP BAR ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E6001E3D"
            app:strokeColor="#334A90E2"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <!-- Sidebar hamburger button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidebar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Open menu"
                    app:icon="@drawable/ic_menu_lines"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#14FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

                <!-- App name + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGLA"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Language Interpreter"
                        android:textColor="#80B0D4FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Result card (centered over camera) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#661A2F3F"
            app:strokeColor="#80FFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/cameraPreview"
            app:layout_constraintBottom_toBottomOf="@id/cameraPreview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="32dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- English result -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HELLO"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false" />

                <!-- Filipino translation -->
                <TextView
                    android:id="@+id/tvFilipinoResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#6AB0FF"
                    android:textSize="22sp"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif" />

                <!-- Confidence + gesture type badge -->
                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98%  [STATIC]"
                    android:textColor="#B0D4FF"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif" />

                <!-- Filipino toggle button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFilipino"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Show Filipino"
                    android:textColor="#6AB0FF"
                    android:textSize="11sp"
                    android:layout_marginTop="10dp"
                    app:strokeColor="#6AB0FF"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Too-many-hands warning -->
        <TextView
            android:id="@+id/tvHandsWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More than 2 hands detected"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#CC000000"
            android:padding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp" />

        <!-- No hands detected overlay -->
        <TextView
            android:id="@+id/tvNoHandsDetected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✋ No Hands Detected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#CCD32F2F"
            android:padding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/topBarCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone" />

        <!-- Emergency button (bottom-right of camera) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergency"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="SOS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="36dp"
            app:layout_constraintBottom_toTopOf="@id/bottomPanelCard"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp" />

        <!-- Emergency hint label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold for emergency"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            app:layout_constraintTop_toBottomOf="@id/btnEmergency"
            app:layout_constraintEnd_toEndOf="@id/btnEmergency"
            app:layout_constraintStart_toStartOf="@id/btnEmergency"
            android:layout_marginTop="-4dp" />

        <!-- ── Bottom panel ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomPanelCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E6001E3D"
            app:strokeColor="#334A90E2"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/bottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="18dp">

                <!-- Buffer progress bar -->
                <ProgressBar
                    android:id="@+id/progressBuffer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#4A90E2"
                    android:progressBackgroundTint="#332F80ED"
                    android:layout_marginBottom="10dp" />

                <!-- Cooldown progress bar -->
                <ProgressBar
                    android:id="@+id/progressCooldown"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#4CAF50"
                    android:progressBackgroundTint="#334CAF50"
                    android:layout_marginBottom="10dp" />

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFrames"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Detecting…"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvVelocity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="#FFB74D"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Status + Cooldown status + Flip button row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loading models…"
                        android:textColor="#B0D4FF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCooldownStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready"
                        android:textColor="#4CAF50"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlipCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#2F80ED"
                        app:strokeColor="#4A90E2"
                        app:strokeWidth="1dp"
                        app:cornerRadius="30dp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="1dp"
                        app:iconTint="#FFFFFF" />

                </LinearLayout>

                <!-- Buffer percent row -->
                <TextView
                    android:id="@+id/tvBufferPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#B0D4FF"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Sidebar (drawer) ── -->
    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
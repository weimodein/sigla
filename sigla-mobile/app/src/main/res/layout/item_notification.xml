<?xml version="1.0" encoding="utf-8"?>
<!--
    item_notification.xml  →  res/layout/
    Used by NotificationsActivity RecyclerView adapter.
    Supports types: ANNOUNCEMENT, APPROVAL, DENIAL, WARNING, MAINTENANCE, SYSTEM
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <!-- Unread left accent bar (blue = unread, transparent = read) -->
    <View
        android:id="@+id/viewUnreadAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#0056A4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Type icon badge -->
        <TextView
            android:id="@+id/tvNotifIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="📢"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_notif_icon_circle"
            android:layout_marginEnd="12dp" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row + unread dot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/tvNotifTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Word Submission Approved"
                    android:textColor="#1F1F1F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Unread dot — hide when read -->
                <View
                    android:id="@+id/viewUnreadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_unread_dot" />

            </LinearLayout>

            <!-- Type chip (e.g. APPROVAL, WARNING, MAINTENANCE) -->
            <TextView
                android:id="@+id/tvNotifType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPROVAL"
                android:textColor="#0056A4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_chip_blue_light"
                android:layout_marginBottom="6dp" />

            <!-- Message body -->
            <TextView
                android:id="@+id/tvNotifMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your submission for the word &quot;KUMUSTA&quot; has been reviewed and approved by the administrator."                android:textColor="#546E7A"
                android:textSize="12sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvNotifTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 hours ago"
                android:textColor="#90A4AE"
                android:textSize="10sp"
                android:letterSpacing="0.03" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
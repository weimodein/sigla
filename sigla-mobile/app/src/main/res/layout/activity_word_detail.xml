<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_word_detail.xml
    Scope:
      - Full-screen word detail (replaces the old bottom sheet): the word
        itself, its demo video/image, and an Add to Favorites toggle
      - Header matches activity_category_word_list.xml (back button + the
        word's category as title) so the whole flow reads as one screen family
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sig_page_bg">

    <!-- TOP BAR -->
    <FrameLayout
        android:id="@+id/topBarOuterWrapper"
        android:layout_width="0dp"
        android:layout_height="122dp"
        android:background="@drawable/bg_topbar_outer"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_topbar_curved"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="Back"
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/sig_icon_accent"
                app:backgroundTint="@color/sig_header_button_bg"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/tvDetailCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Category"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold" />

        </LinearLayout>
    </FrameLayout>

    <!-- WORD -->
    <TextView
        android:id="@+id/tvDetailWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="Hello"
        android:textColor="@color/sig_text_primary"
        android:textSize="38sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toBottomOf="@id/topBarOuterWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DEMO VIDEO / IMAGE BOX -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMedia"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/sig_page_bg"
        app:strokeColor="@color/sig_icon_accent"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/tvDetailWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Gesture demonstration image"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/videoDemo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- No media placeholder (shown when neither image nor video is set) -->
        <LinearLayout
            android:id="@+id/noMediaPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤟"
                android:textSize="40sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No demo available yet"
                android:textColor="@color/sig_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Play button outline (shown until the video/image starts) -->
        <FrameLayout
            android:id="@+id/playOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00000000"
                app:strokeColor="@color/sig_icon_accent"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/sig_icon_accent"
                    android:contentDescription="Play demo" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressVideo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/sig_icon_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMediaCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="14dp"
            android:text="Demo Video"
            android:textColor="@color/sig_text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ADD TO FAVORITES -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToFavorites"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:text="Add to Favorites"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/sig_text_primary"
        android:elevation="3dp"
        app:icon="@android:drawable/btn_star_big_off"
        app:iconTint="@color/sig_accent"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/sig_surface_card"
        app:layout_constraintTop_toBottomOf="@id/cardMedia"
        app:layout_constraintEnd_toEndOf="@id/cardMedia" />

</androidx.constraintlayout.widget.ConstraintLayout>

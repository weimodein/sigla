<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorSurface">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMediaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMediaFilipino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseMedia"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Video player -->
    <FrameLayout
        android:id="@+id/frameVideo"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000"
        android:visibility="gone">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading spinner over video -->
        <ProgressBar
            android:id="@+id/progressVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />
    </FrameLayout>

    <!-- Image viewer (fallback when no video) -->
    <ImageView
        android:id="@+id/ivMediaImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMediaDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone" />

        <!-- Tags row -->
        <LinearLayout
            android:id="@+id/layoutMediaTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvMediaGesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:background="@color/colorSurfaceVariant"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tvMediaHands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:background="@color/colorSurfaceVariant"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvMediaCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:background="@color/colorSurfaceVariant"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="6dp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Audio play button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMediaAudio"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="&#x1F50A;  Play Pronunciation"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            app:backgroundTint="@color/colorSurfaceVariant"
            android:textColor="@color/colorTextPrimary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- Add to custom category button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/add_to_category"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:backgroundTint="@color/colorSurfaceVariant"
            android:textColor="@color/colorTextPrimary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_notifications.xml  →  res/layout/
    Scope:
      - Receives admin-sent notifications: maintenance, updates,
        word submission approvals/denials, warnings, announcements
      - Offline-resilient: delivers once device reconnects
      - Requires internet to load latest notifications
      - Retractable sidebar + back button
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E3F2FD">

        <!-- TOP BAR
             Total height: 12dp marginTop + 10dp pad + 38dp button + 10dp pad + 12dp marginBottom = 82dp -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E6001E3D"
            app:strokeColor="#334A90E2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <!-- Sidebar 3-line hamburger button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidebar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Open menu"
                    app:icon="@drawable/ic_menu_lines"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#14FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

                <!-- Screen title + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Language Interpreter"
                        android:textColor="#80B0D4FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <!-- Unread count badge -->
                <TextView
                    android:id="@+id/tvUnreadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/bg_badge_red"
                    android:layout_marginEnd="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- OFFLINE BANNER (shown when no internet)
             Offset = 82dp (top bar total) -->
        <LinearLayout
            android:id="@+id/bannerOffline"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F57C00"
            android:layout_marginTop="82dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="#FFFFFF"
                android:contentDescription="Offline"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You're offline. Notifications will load when reconnected."
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- FILTER TABS: All / Unread / By Type
             Offset = 82dp (top bar) — sits flush below the card -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsFilter"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="82dp"
            android:background="#FFFFFF"
            app:tabTextColor="#78909C"
            app:tabSelectedTextColor="#0056A4"
            app:tabIndicatorColor="#0056A4"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp"
            app:elevation="2dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNREAD" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANNOUNCEMENTS" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUBMISSIONS" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM" />

        </com.google.android.material.tabs.TabLayout>

        <!-- MARK ALL READ bar
             82dp (top bar) + 44dp (tabs) = 126dp -->
        <LinearLayout
            android:id="@+id/markAllReadBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="#BBDEFB"
            android:layout_marginTop="126dp">

            <TextView
                android:id="@+id/tvNotifSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 unread notifications"
                android:textColor="#0D3E6B"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkAllRead"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Mark all as read"
                android:textSize="11sp"
                android:textColor="#0056A4"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NOTIFICATION LIST
             82dp (top bar) + 44dp (tabs) + 36dp (mark-all bar) = 162dp -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="162dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:layout_marginTop="162dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="#B0BEC5"
                android:layout_marginBottom="16dp"
                android:contentDescription="No notifications" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All caught up!"
                android:textColor="#78909C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No notifications right now. New messages from the admin will appear here."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- LOADING STATE -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="162dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#0056A4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading notifications…"
                android:textColor="#78909C"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- One onboarding feature page (Translate / Learn / Explore): a pale panel with
     the page's illustration (illus_onboard_*), then the eyebrow, title and copy.
     The brand mark, step count, dots and buttons come from activity_onboarding. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg">

    <!-- 48% leaves room below for up to four lines of copy above the dots and
         buttons, even on a ~640dp-tall screen. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/heroBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/sg_tint"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Sigla.OnboardHero"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/heroBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 72dp top margin clears the brand header drawn over the panel. -->
    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/sg_space_24"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="@dimen/sg_space_24"
        android:layout_marginBottom="@dimen/sg_space_16"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/heroBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@drawable/illus_onboard_translate" />

    <TextView
        android:id="@+id/tvPageEyebrow"
        style="@style/Sigla.Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="@dimen/sg_space_32"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/sg_brand_text"
        app:layout_constraintTop_toBottomOf="@id/heroBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Translate" />

    <TextView
        android:id="@+id/tvPageTitle"
        style="@style/Sigla.Text.Display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="@dimen/sg_space_8"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvPageEyebrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Sign, and SigLa speaks" />

    <TextView
        android:id="@+id/tvPageDescription"
        style="@style/Sigla.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="@dimen/sg_space_12"
        android:layout_marginEnd="28dp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/sg_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvPageTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Point your camera at someone signing. SigLa reads the sign and says the word out loud, in English or Filipino." />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Final onboarding step: "What should we call you?" (spec §5). Same hero-panel
     shape as the feature pages, with a text field instead of body copy. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/nameHeaderGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.38" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/sg_brand"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Sigla.OnboardHero"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nameHeaderGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_sg_circle_tint_on_brand">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_onboard_name"
                android:tint="@color/sg_on_brand" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNameEyebrow"
        style="@style/Sigla.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_24"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/sg_brand_text"
        android:text="One last thing"
        app:layout_constraintTop_toBottomOf="@id/nameHeaderGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNameTitle"
        style="@style/Sigla.Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_8"
        android:gravity="center"
        android:text="What should we call you?"
        app:layout_constraintTop_toBottomOf="@id/tvNameEyebrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNameSubtitle"
        style="@style/Sigla.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_8"
        android:gravity="center"
        android:paddingHorizontal="@dimen/sg_space_32"
        android:textColor="@color/sg_text_secondary"
        android:text="So Home can greet you by name. You can change this anytime in Settings."
        app:layout_constraintTop_toBottomOf="@id/tvNameTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="@dimen/sg_search_height"
        android:layout_marginTop="@dimen/sg_space_24"
        android:layout_marginHorizontal="@dimen/sg_space_32"
        android:background="@drawable/bg_sg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sg_space_16"
        app:layout_constraintTop_toBottomOf="@id/tvNameSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUserName"
            style="@style/Sigla.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Your first name"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:textColor="@color/sg_text"
            android:textColorHint="@color/sg_text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

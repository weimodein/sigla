<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_fullscreen_video.xml
    Fullscreen demo video, opened from the word detail screen. The activity
    turns itself landscape for a landscape clip and portrait for a portrait
    one (FullscreenVideoActivity), so the video always fills the screen the
    long way. Tapping anywhere shows/hides the controls.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/videoFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="Sign demonstration video" />

    <ProgressBar
        android:id="@+id/progressFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF" />

    <FrameLayout
        android:id="@+id/fullscreenControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitFullscreen"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="Exit full screen"
            app:icon="@drawable/ic_fullscreen_exit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#66000000"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenPlayPause"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="Pause"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#66000000"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            app:cornerRadius="36dp" />

    </FrameLayout>
</FrameLayout>

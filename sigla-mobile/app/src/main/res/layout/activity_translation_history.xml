<?xml version="1.0" encoding="utf-8"?>
<!-- Translation History (spec §5). Bottom bar navigation (view_bottom_nav.xml).
     Scope rules:
       - Shows list of all previously translated gestures
       - Each entry: badge, word, Filipino translation, time detected
       - Entries grouped by date, most recent at top
       - Max 200 entries; older entries auto-removed when limit reached
       - Swipe left on entry OR tap delete button to delete individual entry
       - Clear All button (requires confirmation dialog) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_screen_padding"
        android:paddingTop="@dimen/sg_space_24"
        android:paddingEnd="@dimen/sg_screen_padding">

        <TextView
            style="@style/Sigla.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History" />
        <TextView
            style="@style/Sigla.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What you've translated" />

        <!-- Summary card: entry count + Clear all -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sigla.Card.Brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/sg_space_16">

                <TextView
                    android:id="@+id/tvEntryCount"
                    style="@style/Sigla.Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/sg_on_brand"
                    tools:text="0 / 200 entries kept" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAll"
                    style="@style/Widget.Sigla.Chip"
                    android:text="Clear all"
                    app:backgroundTint="@color/sg_on_brand"
                    android:textColor="@color/sg_brand_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sg_space_16"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/sg_bottom_bar_clearance"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/sg_space_32"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/sg_badge_size"
                    android:layout_height="@dimen/sg_badge_size"
                    android:background="@drawable/bg_sg_circle_tint">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history_line"
                        android:tint="@color/sg_brand_text" />
                </FrameLayout>

                <TextView
                    style="@style/Sigla.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_16"
                    android:text="No translations yet" />
                <TextView
                    style="@style/Sigla.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_4"
                    android:gravity="center"
                    android:text="Words you translate will appear here." />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/view_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

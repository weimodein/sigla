<?xml version="1.0" encoding="utf-8"?>
<!-- activity_translation_history.xml
     Scope rules:
       - Shows list of all previously translated gestures
       - Each entry: translated word, confidence %, gesture type (Static/Motion), time detected
       - Entries grouped by date, most recent at top
       - Max 200 entries; older entries auto-removed when limit reached
       - Swipe left on entry OR tap delete button to delete individual entry
       - Clear All button (requires confirmation dialog)
       - Retractable sidebar (no back button — sidebar matches activity_main.xml pattern)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E3F2FD">

        <!-- TOP BAR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E6001E3D"
            app:strokeColor="#334A90E2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <!-- Sidebar 3-line hamburger button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSidebar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Open menu"
                    app:icon="@drawable/ic_menu_lines"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#14FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

                <!-- Screen title + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translation History"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Language Interpreter"
                        android:textColor="#80B0D4FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.03"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <!-- Clear All button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Clear All"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#14FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Entry count indicator -->
        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 200 entries"
            android:textColor="#0D3E6B"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:background="#BBDEFB"
            android:layout_marginTop="80dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#B0BEC5"
                android:layout_marginBottom="16dp"
                android:contentDescription="No history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No translations yet"
                android:textColor="#78909C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestures you translate will appear here."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <!--
            RecyclerView: each item is a HistoryEntryItem or a DateHeaderItem.
            Adapter handles date grouping (most recent at top).
            ItemTouchHelper enables swipe-left-to-delete.
            layout_marginTop accounts for topBar (~80dp) + entry count bar (~32dp)
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="112dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Sidebar -->
    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
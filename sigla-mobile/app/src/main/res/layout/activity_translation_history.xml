<?xml version="1.0" encoding="utf-8"?>
<!-- activity_translation_history.xml
     Scope rules:
       - Shows list of all previously translated gestures
       - Each entry: translated word, time detected
       - Entries grouped by date, most recent at top
       - Max 200 entries; older entries auto-removed when limit reached
       - Swipe left on entry OR tap delete button to delete individual entry
       - Clear All button (requires confirmation dialog)
       - Bottom bar navigation (view_bottom_nav.xml)

     Header matches activity_word_bank.xml (same outer halo + navy curve
     drawables/heights) so this screen reads as part of the same app family.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sig_page_bg">

        <!-- TOP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/topBarOuterWrapper"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:background="@drawable/bg_topbar_outer"
                android:elevation="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_topbar_curved"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical">

                    <!-- Screen title + subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Translation History"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Filipino Sign Language Translator"
                            android:textColor="#C2CFE3"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ENTRY COUNT + CLEAR ALL ROW -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/topBarOuterWrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvEntryCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 / 200 entries"
                    android:textColor="@color/sig_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Clear All"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/sig_text_primary"
                    android:elevation="2dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/sig_surface_card" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:layout_marginTop="174dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="@color/sig_text_secondary"
                android:layout_marginBottom="16dp"
                android:contentDescription="No history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No translations yet"
                android:textColor="@color/sig_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestures you translate will appear here."
                android:textColor="@color/sig_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <!--
            RecyclerView: each item is a HistoryEntryItem or a DateHeaderItem.
            Adapter handles date grouping (most recent at top).
            ItemTouchHelper enables swipe-left-to-delete.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="174dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="@dimen/sg_bottom_bar_clearance"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    <include layout="@layout/view_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

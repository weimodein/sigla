<?xml version="1.0" encoding="utf-8"?>
<!-- activity_suggest_word.xml
     Scope rules:
       - Required fields: word, description, number of hands, gesture type, terms checkbox
       - Category is NOT a required submission field per scope
       - Word is normalized (lowercase, punctuation stripped) before duplicate check
       - If word is locked by admin → show locked message, disable Start Collecting
       - If word already exists → prompt user to continue contributing or cancel
       - Terms & Conditions link must be tappable
       - Start Collecting button is disabled until all fields are filled + terms checked
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E3F2FD"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- TOP BAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topBarCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#E6001E3D"
                app:strokeColor="#334A90E2"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <!-- Sidebar 3-line hamburger button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSidebar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="Open menu"
                        app:icon="@drawable/ic_menu_lines"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="#FFFFFF"
                        app:backgroundTint="#14FFFFFF"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp" />

                    <!-- Screen title + subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suggest a Word"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sign Language Interpreter"
                            android:textColor="#80B0D4FF"
                            android:textSize="10sp"
                            android:letterSpacing="0.03"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>



                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/mainCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/topBarCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section: Word Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Word Details"
                            android:textColor="#1A1A2E"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_info"
                            android:contentDescription="Information" />

                    </LinearLayout>

                    <!-- Word input field -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardPreventCornerOverlap="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWord"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxStrokeColor="#4A90E2"
                            app:boxStrokeWidth="1.5dp"
                            app:boxBackgroundColor="#F8F9FF"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:hintEnabled="true"
                            app:hintTextColor="#4A90E2"
                            android:hint="Enter word or phrase">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWord"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="#111111"
                                android:textColorHint="#999999"
                                android:textSize="14sp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </androidx.cardview.widget.CardView>

                    <!--
                        Word status banner:
                        - GONE by default
                        - Shows "Word already exists" prompt when duplicate found
                        - Shows "Submissions locked" when admin has locked this word
                    -->
                    <LinearLayout
                        android:id="@+id/wordStatusBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_hint_blue"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivWordStatusIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_dialog_info"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Status icon" />

                        <TextView
                            android:id="@+id/tvWordStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="#0D3566"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>

                    <!-- Locked word warning -->
                    <LinearLayout
                        android:id="@+id/lockedWordBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#FDECEA"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_lock_lock"
                            android:tint="#B71C1C"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Locked" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Submissions for this word have been locked by the administrator."
                            android:textColor="#B71C1C"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>

                    <!-- User quota reached warning -->
                    <LinearLayout
                        android:id="@+id/quotaReachedBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#FFF3E0"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            android:tint="#E65100"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Quota reached" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="You have already reached the maximum number of samples for this word."
                            android:textColor="#E65100"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>

                    <!-- Description input field -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardPreventCornerOverlap="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDescription"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxStrokeColor="#4A90E2"
                            app:boxStrokeWidth="1.5dp"
                            app:boxBackgroundColor="#F8F9FF"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:counterEnabled="true"
                            app:counterMaxLength="300"
                            app:hintEnabled="true"
                            app:hintTextColor="#4A90E2"
                            android:hint="Description of the gesture">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:maxLines="5"
                                android:maxLength="300"
                                android:textColor="#111111"
                                android:textColorHint="#999999"
                                android:textSize="14sp"
                                android:gravity="top"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8E8EE"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Section: Gesture Configuration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_one_hand"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Gesture configuration" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gesture Configuration"
                            android:textColor="#1A1A2E"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Number of Hands selection -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Number of Hands"
                                android:textColor="#1A1A2E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/btnOneHand"
                                    android:layout_width="0dp"
                                    android:layout_height="90dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_selection_active"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="One hand gesture">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:src="@drawable/ic_one_hand"
                                        android:contentDescription="@null"
                                        android:layout_marginBottom="6dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="One Hand"
                                        android:textColor="#1A1A2E"
                                        android:textSize="13sp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnTwoHands"
                                    android:layout_width="0dp"
                                    android:layout_height="90dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_selection_inactive"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Two hands gesture">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:src="@drawable/ic_two_hands"
                                        android:contentDescription="@null"
                                        android:layout_marginBottom="6dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Both Hands"
                                        android:textColor="#1A1A2E"
                                        android:textSize="13sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Gesture Type selection: Static vs Motion -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gesture Type"
                                android:textColor="#1A1A2E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/btnStatic"
                                    android:layout_width="0dp"
                                    android:layout_height="90dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_selection_active"
                                    android:layout_marginEnd="8dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Static gesture - held in one position">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:src="@drawable/ic_static"
                                        android:contentDescription="@null"
                                        android:layout_marginBottom="6dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Static"
                                        android:textColor="#1A1A2E"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Max 100 samples"
                                        android:textColor="#4A90E2"
                                        android:textSize="10sp"
                                        android:layout_marginTop="2dp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnMotion"
                                    android:layout_width="0dp"
                                    android:layout_height="90dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:background="@drawable/bg_selection_inactive"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Motion gesture - involves movement">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:src="@drawable/ic_motion"
                                        android:contentDescription="@null"
                                        android:layout_marginBottom="6dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Motion"
                                        android:textColor="#1A1A2E"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Max 150 samples"
                                        android:textColor="#4A90E2"
                                        android:textSize="10sp"
                                        android:layout_marginTop="2dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Gesture type hint box -->
                    <LinearLayout
                        android:id="@+id/gestureHintBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_hint_blue"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_dialog_info"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvGestureTypeHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Static gestures are held still. Collection takes approx. 3–5 minutes."
                            android:textColor="#0D3566"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- INFO NOTE: submission review notice -->
            <LinearLayout
                android:id="@+id/infoNoteCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#BBDEFB"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toBottomOf="@id/mainCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="#1976D2"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All submissions are reviewed by an administrator before being added to the Word Bank. The collection process takes approximately 3–5 minutes."
                    android:textColor="#0D3E6B"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- ERROR MESSAGE -->
            <TextView
                android:id="@+id/tvSuggestError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone"
                android:padding="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_error_soft"
                app:layout_constraintTop_toBottomOf="@id/infoNoteCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- TERMS ROW -->
            <LinearLayout
                android:id="@+id/termsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/tvSuggestError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:buttonTint="#1976D2"
                    android:checked="false"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvTermsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I have read the terms and conditions"
                    android:textColor="#0D3E6B"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- START COLLECTING button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartCollecting"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="Start Collecting"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:enabled="false"
                app:backgroundTint="#1976D2"
                app:cornerRadius="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toBottomOf="@id/termsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/nav_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- Clock, for the onboarding Explore page's bottom-bar mockup (History tab).
     White stroke, tinted at point of use, matching Plan 1's icon convention.
     (The real ic_history_line.xml has its stroke colour hardcoded and isn't
     tintable — tracked separately, not fixed here; see mobile-revamp carry-over.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,20a8,8 0,1 0,0 -16a8,8 0,0 0,0 16z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,8v4.5l3,2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
